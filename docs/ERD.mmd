erDiagram
    USERS {
        int UserID
        varchar FullName
        varchar Email
        varchar PasswordHash
        varchar Role
        datetime DateJoined
    }

    ORGANISERDETAILS {
        int OrganiserID
        varchar ClubName
        varchar PhoneNumber
        varchar Bio
    }

    EVENTS {
        int EventID
        int OrganiserID
        varchar EventName
        varchar Description
        datetime EventDate
        varchar Location
        bit IsActive
    }

    CATEGORIES {
        int CategoryID
        int EventID
        varchar CategoryName
        int MaxParticipants
        decimal EntryFee
    }

    ENROLMENTS {
        int EnrolmentID
        int ParticipantID
        int CategoryID
        datetime EnrolmentDate
    }

    RESULTS {
        int ResultID
        int EnrolmentID
        time FinishTime
        int Position
        varchar Status
    }

    USERS ||--o| ORGANISERDETAILS : "has details"
    USERS ||--o{ EVENTS : "creates"
    EVENTS ||--o{ CATEGORIES : "has"
    CATEGORIES ||--o{ ENROLMENTS : "has"
    USERS ||--o{ ENROLMENTS : "enrols in"
    ENROLMENTS ||--o| RESULTS : "has"
